{
  "name": "nestly-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fig": "node tools/fig/decode.mjs && node tools/fig/spec.mjs && node tools/fig/tokens.mjs && node tools/fig/assets.mjs",
    "shot": "node tools/shot.mjs",
    "smoke": "node tools/smoke.mjs && node tools/smoke.mjs --lang zh-Hant && node tools/smoke.mjs --lang zh-Hans",
    "e2e": "node tools/e2e.mjs",
    "check": "tsc -p . && vitest run && vite build && npm run smoke && node tools/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "kiwi-schema": "^0.5.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
